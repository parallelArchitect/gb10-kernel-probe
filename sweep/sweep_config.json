      "f32",
      "f16"
    ]
  },
  "gb10_specific": {
    "bandwidth_pressure": [
      {
        "label": "idle",
        "description": "No concurrent workload. Baseline: GPU read ~161 GB/s.",
        "concurrent_load": false
      },
      {
        "label": "loaded",
        "description": "Concurrent inference load active. Baseline: GPU read ~90 GB/s (-44%).",
        "concurrent_load": true,
        "load_script": "probes/bw_load.sh"
      }
    ],
    "pcie_check_required": true,
    "doe_check_required": true,
    "nvml_clock_mem_na": true,
    "cupti_uma_blocked": true,
    "cluster_shape_requires_gb10": true
  },
  "output": {
    "results_dir": "results/",
    "filename_template": "sweep_{platform}_{timestamp}.jsonl",
    "fields_per_run": [
      "platform",
      "driver",
      "cuda_version",
      "timestamp",
      "tb_shape",
      "warp_shape",
      "stages",
      "data_type",
      "layout",
      "alignment",
      "mma_instruction",
      "cluster_shape",
      "bw_pressure_label",
      "tflops",
      "occupancy",
      "registers",
      "smem_bytes",
      "instruction_path",
      "ptx_mma_form",
      "ptx_barrier_type",
      "ptx_cp_async",
      "ptx_tma",
      "link_state_at_capture",
      "pre_run_check_result"
    ]
  },
  "pascal_dev_notes": {
    "description": "Pascal SM6.1 subset for local tool validation only",
    "skip_axes": [
      "mma_instruction",
      "cluster_shape",
      "gb10_specific.bandwidth_pressure"
